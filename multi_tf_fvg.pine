//@version=5
indicator("Multi-TF FVG (4H + 15M)", overlay=true, max_lines_count=500, max_labels_count=500)

// ============================================================================
// Multi-Timeframe Fair Value Gap (FVG) Indicator
// ----------------------------------------------------------------------------
// Detects Fair Value Gaps on the 4H and 15M timeframes and draws them on
// ANY chart timeframe you are currently viewing.
//
// An FVG (a.k.a. imbalance) is a 3-candle pattern:
//   Bullish FVG : low of candle[1]  >  high of candle[3]   (gap between them)
//   Bearish FVG : high of candle[1] <  low  of candle[3]   (gap between them)
//
// Each FVG is drawn as THREE horizontal lines — Top, CE (midpoint), Bottom —
// each with a text label at its right end:
//   +4H FVG Top / CE / Bottom     ( + = bullish, white )
//   -4H FVG Top / CE / Bottom     ( - = bearish, red   )
//   +15M FVG Top / CE / Bottom
//   -15M FVG Top / CE / Bottom
//
// Each line extends to the right until its own level is mitigated (touched by
// price), at which point the line is discontinued — frozen at the bar where
// the mitigation happened.
// ============================================================================


// ─────────────────────────────── Inputs ────────────────────────────────────
grp1 = "4H FVG Settings"
show4h        = input.bool(true,   "Show 4H FVGs",       group=grp1)
tf4h          = input.timeframe("240", "4H Timeframe",   group=grp1)

grp2 = "15M FVG Settings"
show15m       = input.bool(true,   "Show 15M FVGs",      group=grp2)
tf15m         = input.timeframe("15",  "15M Timeframe",  group=grp2)

grp5 = "Line & Color Settings"
bull4hCol     = input.color(color.white,  "4H Bullish (+) color",  group=grp5, inline="c4")
bear4hCol     = input.color(color.red,    "4H Bearish (-) color",  group=grp5, inline="c4")
bull15mCol    = input.color(color.aqua,   "15M Bullish (+) color", group=grp5, inline="c15")
bear15mCol    = input.color(color.orange, "15M Bearish (-) color", group=grp5, inline="c15")
lineWidth     = input.int(1, "Line width", minval=1, maxval=4, group=grp5)
showTopLn     = input.bool(true, "Show Top line",    group=grp5, inline="which")
showCELn      = input.bool(true, "Show CE line",     group=grp5, inline="which")
showBotLn     = input.bool(true, "Show Bottom line", group=grp5, inline="which")
mitModeInp    = input.string("Wick", "Mitigation by", options=["Wick","Body"], group=grp5, tooltip="A level freezes only when price RE-ENTERS the gap from the correct side. Wick = the candle wick reaching the level (high/low); Body = the candle body reaching it (open/close).")

grp6 = "Proximity Arrow"
showArrows    = input.bool(true, "Show proximity arrows", group=grp6, tooltip="Draw a red left-pointing arrow whenever any 4H level (Top/CE/Bottom) is within the threshold of any same-direction 15M level. The arrow is removed if either linked level is mitigated.")
arrowThresh   = input.float(4.0, "Arrow max distance (points)", minval=0.0, step=0.1, group=grp6)
arrowCol      = input.color(color.red, "Arrow color", group=grp6)
arrowWidth    = input.int(2, "Arrow width", minval=1, maxval=5, group=grp6)
arrowLen      = input.int(20, "Arrow length (bars)", minval=1, maxval=200, group=grp6, tooltip="How far to the right of the lines the arrow's tail extends. The arrowhead points left toward the two close lines.")

grp4 = "General"
maxFvgs       = input.int(20,  "Max FVGs to keep per set", minval=1, maxval=100, group=grp4)
extendBars    = input.int(30,  "Extend lines (bars)",      minval=0, maxval=500, group=grp4)
showLabels    = input.bool(true, "Show text labels",   group=grp4)
lblSizeInp    = input.string("Small", "Label text size", options=["Tiny","Small","Normal","Large"], group=grp4)
lblFontInp    = input.string("Default", "Label font", options=["Default","Monospace"], group=grp4, tooltip="Pine Script only supports these two font families — a true Arial cannot be selected. 'Default' is TradingView's standard sans-serif (Arial-like).")

grp7 = "Dashboard (color legend)"
showDash      = input.bool(true, "Show dashboard", group=grp7)
dashPosInp    = input.string("Top Right", "Position", options=["Top Right","Top Left","Bottom Right","Bottom Left","Middle Right"], group=grp7)
dashSizeInp   = input.string("Small", "Dashboard text size", options=["Tiny","Small","Normal","Large"], group=grp7)
dashBgCol     = input.color(color.new(color.black, 20), "Background", group=grp7, inline="dbg")
dashTxtCol    = input.color(color.white, "Text", group=grp7, inline="dbg")


// ─────────────────────────── FVG data type ─────────────────────────────────
// Each FVG owns 3 lines and their 3 labels. A line is `na` when its level is
// hidden by the user. `topDone/ceDone/botDone` mark a level as mitigated so it
// stops extending (the line is left frozen at the mitigation bar).
type FVG
    float top
    float ce
    float bot
    bool  isBull
    int   dispStart   // displacement candle open time (ms)
    int   dispEnd     // displacement candle close time (ms) = start + TF duration
    line  topLn
    line  ceLn
    line  botLn
    label topLbl
    label ceLbl
    label botLbl
    bool  topDone
    bool  ceDone
    bool  botDone


// A proximity arrow linking a 4H level to a nearby same-direction 15M level.
// `f4`/`f15` are the two FVGs; `lvl4`/`lvl15` are the level indices
// (0 = Top, 1 = CE, 2 = Bottom) so we can watch each side's mitigation flag.
type Arrow
    line ln
    FVG  f4
    int  lvl4
    FVG  f15
    int  lvl15


// ─────────────── Request 3-candle data from a higher timeframe ──────────────
// We pull high/low of candle[1] and candle[3] plus the bar time of candle[2]
// (the middle candle, which anchors the gap on the timeline).
reqTF(simple string tf) =>
    request.security(syminfo.tickerid, tf,
         [high[1], low[1], high[3], low[3], time[2], ta.change(time[1]) != 0],
         lookahead=barmerge.lookahead_off)


// CE (Consequent Encroachment) = midpoint of an FVG.
ceOf(float top, float bot) => (top + bot) / 2.0

// Has price reached `lvl` from BELOW (rallying up into it)? Used to mitigate
// bearish-FVG levels, which sit above and are filled when price rallies back up.
//   Wick mode → the bar's high reaches lvl.
//   Body mode → the bar's body top (max of open/close) reaches lvl.
reachedFromBelow(float lvl) =>
    (mitModeInp == "Body" ? math.max(open, close) : high) >= lvl

// Has price reached `lvl` from ABOVE (dropping down into it)? Used to mitigate
// bullish-FVG levels, which sit below and are filled when price drops back down.
//   Wick mode → the bar's low reaches lvl.
//   Body mode → the bar's body bottom (min of open/close) reaches lvl.
reachedFromAbove(float lvl) =>
    (mitModeInp == "Body" ? math.min(open, close) : low) <= lvl

// Map label-size input string to a Pine size constant.
lblSize() =>
    lblSizeInp == "Tiny" ? size.tiny : lblSizeInp == "Normal" ? size.normal : lblSizeInp == "Large" ? size.large : size.small

// Map label-font input string to a Pine font-family constant.
// Pine only exposes these two families — no custom/Arial font is available.
lblFont() =>
    lblFontInp == "Monospace" ? font.family_monospace : font.family_default

// Map dashboard position / size input strings to Pine constants.
dashPos() =>
    dashPosInp == "Top Left" ? position.top_left : dashPosInp == "Bottom Right" ? position.bottom_right : dashPosInp == "Bottom Left" ? position.bottom_left : dashPosInp == "Middle Right" ? position.middle_right : position.top_right
dashSize() =>
    dashSizeInp == "Tiny" ? size.tiny : dashSizeInp == "Normal" ? size.normal : dashSizeInp == "Large" ? size.large : size.small


// Price of a level by index: 0 = Top, 1 = CE, 2 = Bottom.
lvlPrice(FVG f, int idx) =>
    idx == 0 ? f.top : idx == 1 ? f.ce : f.bot

// Whether a level (by index) has been mitigated (its *Done flag).
lvlDone(FVG f, int idx) =>
    idx == 0 ? f.topDone : idx == 1 ? f.ceDone : f.botDone


// Create one horizontal level line + right-end label. Returns [line, label].
mkLevel(int t2mid, float lvl, color col, string txt, bool show, bool showLbl) =>
    line  ln = na
    label lb = na
    if show
        ln := line.new(x1 = t2mid, y1 = lvl, x2 = t2mid + 1, y2 = lvl, xloc = xloc.bar_time, color = col, style = line.style_solid, width = lineWidth)
        if showLbl
            lb := label.new(x = t2mid + 1, y = lvl, xloc = xloc.bar_time, text = txt, textcolor = col, color = color.new(color.black, 100), style = label.style_label_left, size = lblSize(), text_font_family = lblFont())
    [ln, lb]


// ─────────────────────── FVG detection + drawing ───────────────────────────
// Detects a new FVG on the given HTF stream and appends it to `store`, drawing
// the Top/CE/Bottom lines and labels. `tfMs` bounds the displacement window.
// Returns [confirmed, bot, top, isBull, dispStart, dispEnd] for the new FVG.
detectFVG(array<FVG> store, float hh1, float ll1, float hh3, float ll3, int t2mid, int tfMs, bool isNew, string tfLabel, bool visible, bool showLbl, color bullC, color bearC) =>
    bool  drawn   = false
    float newTop  = na
    float newBot  = na
    bool  newBull = false
    int   newDS   = na
    int   newDE   = na
    if isNew and not na(hh1) and not na(hh3)
        bool bull = ll1 > hh3          // gap up: current low above old high
        bool bear = hh1 < ll3          // gap down: current high below old low
        if bull or bear
            float top = bull ? ll1 : ll3
            float bot = bull ? hh3 : hh1
            float ceL = ceOf(top, bot)
            int dStart = t2mid
            int dEnd   = t2mid + tfMs
            drawn   := true
            newTop  := top
            newBot  := bot
            newBull := bull
            newDS   := dStart
            newDE   := dEnd

            color col  = bull ? bullC : bearC
            string sgn = bull ? "+" : "-"           // + bullish, - bearish
            string pfx = sgn + tfLabel + " FVG "    // e.g. "+4H FVG "

            [tLn, tLb] = mkLevel(t2mid, top, col, pfx + "Top",    visible and showTopLn, showLbl)
            [cLn, cLb] = mkLevel(t2mid, ceL, col, pfx + "CE",     visible and showCELn,  showLbl)
            [bLn, bLb] = mkLevel(t2mid, bot, col, pfx + "Bottom", visible and showBotLn, showLbl)

            store.push(FVG.new(top, ceL, bot, bull, dStart, dEnd, tLn, cLn, bLn, tLb, cLb, bLb, false, false, false))

            // Trim oldest (delete its drawings).
            if store.size() > maxFvgs
                FVG old = store.shift()
                line.delete(old.topLn)
                line.delete(old.ceLn)
                line.delete(old.botLn)
                label.delete(old.topLbl)
                label.delete(old.ceLbl)
                label.delete(old.botLbl)
    [drawn, newBot, newTop, newBull, newDS, newDE]


// Extends each still-active level to the right, and DISCONTINUES a level (stops
// extending, leaves it frozen) once price touches that specific level.
maintainFVG(array<FVG> store) =>
    if store.size() > 0
        int newRight = time + extendBars * (timeframe.in_seconds() * 1000)
        for i = 0 to store.size() - 1
            FVG f = store.get(i)

            // A level is mitigated only when price RE-ENTERS the gap from the
            // side it was left open:
            //   Bullish FVG (gap below price) → filled from ABOVE  (price drops in)
            //   Bearish FVG (gap above price) → filled from BELOW  (price rallies in)
            // On mitigation, freeze the line's right edge at THIS bar's time so
            // it ends exactly where price re-entered it.

            // Top level.
            if not f.topDone
                bool hitTop = f.isBull ? reachedFromAbove(f.top) : reachedFromBelow(f.top)
                if hitTop
                    f.topDone := true
                    if not na(f.topLn)
                        line.set_x2(f.topLn, time)
                        if not na(f.topLbl)
                            label.set_x(f.topLbl, time)
                else if not na(f.topLn)
                    line.set_x2(f.topLn, newRight)
                    // Label floats at the latest real bar so it stays visible.
                    if not na(f.topLbl)
                        label.set_x(f.topLbl, time)

            // Bottom level.
            if not f.botDone
                bool hitBot = f.isBull ? reachedFromAbove(f.bot) : reachedFromBelow(f.bot)
                if hitBot
                    f.botDone := true
                    if not na(f.botLn)
                        line.set_x2(f.botLn, time)
                        if not na(f.botLbl)
                            label.set_x(f.botLbl, time)
                else if not na(f.botLn)
                    line.set_x2(f.botLn, newRight)
                    if not na(f.botLbl)
                        label.set_x(f.botLbl, time)

            // CE (midpoint) level.
            if not f.ceDone
                bool hitCE = f.isBull ? reachedFromAbove(f.ce) : reachedFromBelow(f.ce)
                if hitCE
                    f.ceDone := true
                    if not na(f.ceLn)
                        line.set_x2(f.ceLn, time)
                        if not na(f.ceLbl)
                            label.set_x(f.ceLbl, time)
                else if not na(f.ceLn)
                    line.set_x2(f.ceLn, newRight)
                    if not na(f.ceLbl)
                        label.set_x(f.ceLbl, time)
    true


// When a 4H FVG has just confirmed, create a red left-pointing arrow for every
// (4H level, 15M level) pair — same direction, 15M formed during the 4H
// displacement window — whose prices are within `thresh` points. The arrow is
// stored so it can be removed later if either linked level is mitigated.
addArrows(array<Arrow> arrows, FVG f4, array<FVG> m15, float thresh, int rightTime, color col, int width) =>
    if m15.size() > 0
        for i = 0 to m15.size() - 1
            FVG f15 = m15.get(i)
            if f15.isBull == f4.isBull and f15.dispStart >= f4.dispStart and f15.dispStart < f4.dispEnd
                for a4 = 0 to 2
                    for a15 = 0 to 2
                        float p4  = lvlPrice(f4,  a4)
                        float p15 = lvlPrice(f15, a15)
                        if not lvlDone(f4, a4) and not lvlDone(f15, a15) and math.abs(p4 - p15) <= thresh
                            float mid = (p4 + p15) / 2.0
                            // Arrowhead on the LEFT (points toward the lines);
                            // tail extends `arrowLen` bars to the right.
                            line al = line.new(x1 = rightTime, y1 = mid, x2 = rightTime + arrowLen * (timeframe.in_seconds() * 1000), y2 = mid, xloc = xloc.bar_time, color = col, width = width, style = line.style_arrow_left)
                            arrows.push(Arrow.new(al, f4, a4, f15, a15))
    true


// Remove any arrow whose 4H or 15M linked level has been mitigated.
maintainArrows(array<Arrow> arrows) =>
    if arrows.size() > 0
        for i = arrows.size() - 1 to 0
            Arrow a = arrows.get(i)
            if lvlDone(a.f4, a.lvl4) or lvlDone(a.f15, a.lvl15)
                line.delete(a.ln)
                arrows.remove(i)
    true


// ───────────────────────────── Storage ─────────────────────────────────────
var array<FVG>   fvg4h   = array.new<FVG>()
var array<FVG>   fvg15m  = array.new<FVG>()
var array<Arrow> arrows  = array.new<Arrow>()


// ─────────────────────── Pull HTF streams ──────────────────────────────────
[H1_4h, L1_4h, H3_4h, L3_4h, T2_4h, isNew4h]     = reqTF(tf4h)
[H1_15, L1_15, H3_15, L3_15, T2_15, isNew15]     = reqTF(tf15m)

int ms4h = timeframe.in_seconds(tf4h)  * 1000
int ms15 = timeframe.in_seconds(tf15m) * 1000


// ─────────────────────────── Run detection ─────────────────────────────────
// Detect and store 15M FVGs FIRST. A 4H FVG confirms ~8h after its displacement
// candle, so the 15M FVGs that formed *during* that candle already exist in the
// store by the time the 4H FVG is confirmed (used by the proximity arrows).
if show15m
    detectFVG(fvg15m, H1_15, L1_15, H3_15, L3_15, T2_15, ms15, isNew15, "15M", true, showLabels, bull15mCol, bear15mCol)
maintainFVG(fvg15m)

bool new4h = false
if show4h or showArrows
    [d4, b4, t4, bull4, ds4, de4] = detectFVG(fvg4h, H1_4h, L1_4h, H3_4h, L3_4h, T2_4h, ms4h, isNew4h, "4H", show4h, showLabels and show4h, bull4hCol, bear4hCol)
    new4h := d4
maintainFVG(fvg4h)

// Proximity arrows: on a fresh 4H FVG, link its levels to nearby 15M levels.
if showArrows and new4h and fvg4h.size() > 0
    int rightT = time + extendBars * (timeframe.in_seconds() * 1000)
    addArrows(arrows, fvg4h.last(), fvg15m, arrowThresh, rightT, arrowCol, arrowWidth)
// Remove arrows whose linked levels have since been mitigated.
maintainArrows(arrows)


// ─────────────────────────── Dashboard (legend) ────────────────────────────
// A small color legend explaining what each line/marker color means. Built
// once on the last bar for efficiency; rebuilt if inputs change.
var table dash = na
if showDash and barstate.islast
    if not na(dash)
        table.delete(dash)
    dash := table.new(position = dashPos(), columns = 2, rows = 6, bgcolor = dashBgCol, border_color = color.new(color.gray, 50), border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)

    // Header
    table.cell(dash, 0, 0, "FVG Legend", text_color = dashTxtCol, text_size = dashSize(), text_font_family = lblFont())
    table.cell(dash, 1, 0, "", text_color = dashTxtCol, text_size = dashSize())

    // Helper via inline rows: swatch cell (colored bg) + description cell.
    table.cell(dash, 0, 1, "  ", bgcolor = bull4hCol)
    table.cell(dash, 1, 1, "+4H FVG (bullish)",  text_color = dashTxtCol, text_size = dashSize(), text_font_family = lblFont())
    table.cell(dash, 0, 2, "  ", bgcolor = bear4hCol)
    table.cell(dash, 1, 2, "-4H FVG (bearish)",  text_color = dashTxtCol, text_size = dashSize(), text_font_family = lblFont())
    table.cell(dash, 0, 3, "  ", bgcolor = bull15mCol)
    table.cell(dash, 1, 3, "+15M FVG (bullish)", text_color = dashTxtCol, text_size = dashSize(), text_font_family = lblFont())
    table.cell(dash, 0, 4, "  ", bgcolor = bear15mCol)
    table.cell(dash, 1, 4, "-15M FVG (bearish)", text_color = dashTxtCol, text_size = dashSize(), text_font_family = lblFont())
    table.cell(dash, 0, 5, "  ", bgcolor = arrowCol)
    table.cell(dash, 1, 5, "Proximity arrow",  text_color = dashTxtCol, text_size = dashSize(), text_font_family = lblFont())


// ───────────────────────────── Alerts ──────────────────────────────────────
alertcondition(isNew4h and show4h,  "New 4H FVG",  "A new 4H Fair Value Gap has formed")
alertcondition(isNew15 and show15m, "New 15M FVG", "A new 15M Fair Value Gap has formed")
