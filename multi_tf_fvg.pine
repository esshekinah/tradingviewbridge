//@version=5
indicator("Multi-TF FVG (4H + 15M)", overlay=true, max_boxes_count=500, max_lines_count=500)

// ============================================================================
// Multi-Timeframe Fair Value Gap (FVG) Indicator
// ----------------------------------------------------------------------------
// Detects Fair Value Gaps on the 4H and 15M timeframes and draws them on
// ANY chart timeframe you are currently viewing.
//
// An FVG (a.k.a. imbalance) is a 3-candle pattern:
//   Bullish FVG : low of candle[1]  >  high of candle[3]   (gap between them)
//   Bearish FVG : high of candle[1] <  low  of candle[3]   (gap between them)
// The gap is the untraded price range between candle 1 and candle 3.
// ============================================================================


// ─────────────────────────────── Inputs ────────────────────────────────────
grp1 = "4H FVG Settings"
show4h        = input.bool(true,  "Show 4H FVGs",                 group=grp1)
tf4h          = input.timeframe("240", "4H Timeframe",            group=grp1)
bull4hCol     = input.color(color.new(color.teal,   80), "4H Bullish",  group=grp1, inline="c4")
bear4hCol     = input.color(color.new(color.red,    80), "4H Bearish",  group=grp1, inline="c4")
show4hCE      = input.bool(true, "Show 4H CE line",  group=grp1)
ce4hCol       = input.color(color.new(color.teal, 0), "4H CE color", group=grp1, inline="ce4")

grp2 = "15M FVG Settings"
show15m       = input.bool(true,  "Show 15M FVGs",                group=grp2)
tf15m         = input.timeframe("15", "15M Timeframe",            group=grp2)
bull15mCol    = input.color(color.new(color.aqua,   70), "15M Bullish", group=grp2, inline="c15")
bear15mCol    = input.color(color.new(color.orange, 70), "15M Bearish", group=grp2, inline="c15")
show15mCE     = input.bool(true, "Show 15M CE line", group=grp2)
ce15mCol      = input.color(color.new(color.orange, 0), "15M CE color", group=grp2, inline="ce15")

grp3 = "Signal Settings"
showSignals   = input.bool(true, "Show Buy/Sell signals", group=grp3)
signalThresh  = input.float(4.0, "Max line distance (price points)", minval=0.0, step=0.1, group=grp3, tooltip="A signal fires when a same-direction 15M FVG formed DURING the 4H displacement candle AND any 4H level (Bottom/CE/Top) is within this many price points of any 15M level. Set to match the instrument's scale — e.g. ~4 on an index like US Tech 100.")
buyCol        = input.color(color.lime, "Buy signal",  group=grp3, inline="sig")
sellCol       = input.color(color.red,  "Sell signal", group=grp3, inline="sig")

grp4 = "General"
maxFvgs       = input.int(20,  "Max FVGs to keep per set", minval=1, maxval=100, group=grp4)
extendBars    = input.int(30,  "Extend boxes (bars)",      minval=0, maxval=500, group=grp4)
removeFilled  = input.bool(true, "Remove FVG when filled (mitigated)", group=grp4)
showLabels    = input.bool(true, "Show timeframe labels",   group=grp4)
borderWidth   = input.int(1,   "Border width", minval=0, maxval=4, group=grp4)
ceStyleInp    = input.string("Dashed", "CE line style", options=["Solid","Dashed","Dotted"], group=grp4)
ceWidth       = input.int(1,   "CE line width", minval=1, maxval=4, group=grp4)


// ─────────────────────────── FVG data type ─────────────────────────────────
type FVG
    box   bx
    float top
    float bot
    bool  isBull
    bool  filled
    int   dispStart   // displacement candle open time (ms)
    int   dispEnd     // displacement candle close time (ms) = start + TF duration
    line  ceLn        // CE (midpoint) line, na if not drawn


// ─────────────── Request 3-candle data from a higher timeframe ──────────────
// We pull high/low of candle[1] and candle[3] plus the bar time of candle[2]
// (the middle candle, which anchors the gap on the timeline).
// Wrapped in a function so we can reuse it for each timeframe.
reqTF(simple string tf) =>
    request.security(syminfo.tickerid, tf,
         [high[1], low[1], high[3], low[3], time[2], ta.change(time[1]) != 0],
         lookahead=barmerge.lookahead_off)


// CE (Consequent Encroachment) = midpoint of an FVG.
ce(float top, float bot) => (top + bot) / 2.0

// Map the CE line-style input string to a Pine line style constant.
ceStyle() =>
    ceStyleInp == "Solid"  ? line.style_solid  : ceStyleInp == "Dotted" ? line.style_dotted : line.style_dashed


// Returns true if the given 4H FVG levels are within `thresh` price points of
// the given 15M FVG levels (any of the 9 Bottom/CE/Top line-to-line distances).
levelsNear(float bot4, float ce4, float top4, float bot15, float ce15, float top15, float thresh) =>
    math.abs(bot4 - bot15) <= thresh or math.abs(bot4 - ce15) <= thresh or math.abs(bot4 - top15) <= thresh or math.abs(ce4 - bot15) <= thresh or math.abs(ce4 - ce15) <= thresh or math.abs(ce4 - top15) <= thresh or math.abs(top4 - bot15) <= thresh or math.abs(top4 - ce15) <= thresh or math.abs(top4 - top15) <= thresh


// When a 4H FVG has just confirmed, scan the stored 15M FVGs and return true if
// ANY same-direction 15M FVG (a) formed DURING this 4H FVG's displacement candle
// window and (b) has a level within `thresh` price points of a 4H level.
// This runs on 4H confirmation because a 4H FVG is only known ~8h AFTER its
// displacement candle — long after the 15M FVGs inside it have already formed.
signalOn4hConfirm(array<FVG> m15, float bot4, float top4, int dStart, int dEnd, bool isBull, float thresh) =>
    bool hit = false
    if m15.size() > 0
        float ce4 = ce(top4, bot4)
        for i = 0 to m15.size() - 1
            FVG f = m15.get(i)
            if f.isBull == isBull and f.dispStart >= dStart and f.dispStart < dEnd
                if levelsNear(bot4, ce4, top4, f.bot, ce(f.top, f.bot), f.top, thresh)
                    hit := true
    hit


// ─────────────────────── FVG detection + drawing ───────────────────────────
// Detects a new FVG on the given HTF stream and appends it to `store`.
// `tfMs` is the duration of one bar of this FVG's timeframe, in milliseconds,
// used to bound the displacement candle window [t2mid, t2mid + tfMs).
// Returns [confirmed, bot, top, isBull, dispStart, dispEnd] for the new FVG so
// the caller can run cross-timeframe signal logic on confirmation.
detectFVG(array<FVG> store, float hh1, float ll1, float hh3, float ll3, int t2mid, int tfMs, bool isNew, color bullCol, color bearCol, string tfLabel, bool showLbl, bool visible, bool showCE, color ceCol) =>
    bool  drawn   = false
    float newTop  = na
    float newBot  = na
    bool  newBull = false
    int   newDS   = na
    int   newDE   = na
    if isNew and not na(hh1) and not na(hh3)
        bool bull = ll1 > hh3          // gap up: current low above old high
        bool bear = hh1 < ll3          // gap down: current high below old low
        if bull or bear
            float top = bull ? ll1 : ll3
            float bot = bull ? hh3 : hh1
            // Displacement candle window = [t2mid, t2mid + tfMs).
            int dStart = t2mid
            int dEnd   = t2mid + tfMs
            drawn   := true
            newTop  := top
            newBot  := bot
            newBull := bull
            newDS   := dStart
            newDE   := dEnd
            color col      = bull ? bullCol : bearCol
            // When not visible, draw transparent so the box still exists for logic.
            color bgCol    = visible ? col : color.new(col, 100)
            color bordCol  = visible ? color.new(col, 0) : color.new(col, 100)
            box b = box.new(left = t2mid, top = top, right = t2mid + 1, bottom = bot, xloc = xloc.bar_time, border_color = bordCol, border_width = borderWidth, bgcolor = bgCol)
            if showLbl
                box.set_text(b, tfLabel + (bull ? " Bull FVG" : " Bear FVG"))
                box.set_text_size(b, size.tiny)
                box.set_text_color(b, color.new(color.gray, 20))
                box.set_text_halign(b, text.align_left)
                box.set_text_valign(b, text.align_center)
            // CE (midpoint) line spanning the FVG box.
            line ceLine = na
            if visible and showCE
                float ceLvl = ce(top, bot)
                ceLine := line.new(x1 = t2mid, y1 = ceLvl, x2 = t2mid + 1, y2 = ceLvl, xloc = xloc.bar_time, color = ceCol, style = ceStyle(), width = ceWidth)
            store.push(FVG.new(b, top, bot, bull, false, dStart, dEnd, ceLine))
            // Trim oldest
            if store.size() > maxFvgs
                FVG old = store.shift()
                box.delete(old.bx)
                if not na(old.ceLn)
                    line.delete(old.ceLn)
    [drawn, newBot, newTop, newBull, newDS, newDE]


// Keeps FVG boxes extending to the right, and removes mitigated ones.
maintainFVG(array<FVG> store) =>
    if store.size() > 0
        for i = store.size() - 1 to 0
            FVG f = store.get(i)
            if not f.filled
                // extend the box (and CE line) forward in time
                int newRight = time + extendBars * (timeframe.in_seconds() * 1000)
                box.set_right(f.bx, newRight)
                if not na(f.ceLn)
                    line.set_x2(f.ceLn, newRight)
                // mitigation check: price traded fully through the gap
                bool mitigated = f.isBull ? (low <= f.bot) : (high >= f.top)
                if mitigated
                    f.filled := true
                    if removeFilled
                        box.delete(f.bx)
                        if not na(f.ceLn)
                            line.delete(f.ceLn)
                        store.remove(i)


// ───────────────────────────── Storage ─────────────────────────────────────
var array<FVG> fvg4h  = array.new<FVG>()
var array<FVG> fvg15m = array.new<FVG>()


// ─────────────────────── Pull HTF streams ──────────────────────────────────
[H1_4h, L1_4h, H3_4h, L3_4h, T2_4h, isNew4h]     = reqTF(tf4h)
[H1_15, L1_15, H3_15, L3_15, T2_15, isNew15]     = reqTF(tf15m)

// Bar duration (ms) for each configured timeframe — used to bound the
// displacement candle window [start, start + duration).
int ms4h = timeframe.in_seconds(tf4h)  * 1000
int ms15 = timeframe.in_seconds(tf15m) * 1000


// ─────────────────────────── Run detection ─────────────────────────────────
// Detect and store 15M FVGs FIRST. A 4H FVG confirms ~8h after its displacement
// candle, so the 15M FVGs that formed *during* that candle already exist in the
// store by the time the 4H FVG is confirmed. Signals are therefore emitted on
// 4H confirmation, scanning backward over the stored 15M FVGs.
if show15m
    detectFVG(fvg15m, H1_15, L1_15, H3_15, L3_15, T2_15, ms15, isNew15, bull15mCol, bear15mCol, "15M", showLabels, true, show15mCE, ce15mCol)
maintainFVG(fvg15m)

// Detect 4H FVGs whenever they're shown OR needed for signals.
bool  new4h    = false
float n4Bot    = na
float n4Top    = na
bool  n4Bull   = false
int   n4DS     = na
int   n4DE     = na
if show4h or showSignals
    [d4, b4, t4, bull4, ds4, de4] = detectFVG(fvg4h, H1_4h, L1_4h, H3_4h, L3_4h, T2_4h, ms4h, isNew4h, bull4hCol, bear4hCol, "4H", showLabels and show4h, show4h, show4hCE, ce4hCol)
    new4h  := d4
    n4Bot  := b4
    n4Top  := t4
    n4Bull := bull4
    n4DS   := ds4
    n4DE   := de4
maintainFVG(fvg4h)


// ─────────────────────── Buy / Sell signal logic ───────────────────────────
// When a 4H FVG confirms, scan stored 15M FVGs. If any SAME-DIRECTION 15M FVG
// (a) formed DURING this 4H FVG's displacement candle window, and (b) has a
// level (Bottom / CE / Top) within `signalThresh` price points of a 4H level,
// fire a signal:
//   Buy  → bullish 4H+15M pair   |   Sell → bearish pair
bool buySignal  = false
bool sellSignal = false
if showSignals and new4h and not na(n4Bot)
    bool aligned = signalOn4hConfirm(fvg15m, n4Bot, n4Top, n4DS, n4DE, n4Bull, signalThresh)
    if aligned
        buySignal  := n4Bull
        sellSignal := not n4Bull

plotshape(buySignal,  title="Buy",  style=shape.triangleup,   location=location.belowbar, color=buyCol,  size=size.small, text="BUY",  textcolor=buyCol)
plotshape(sellSignal, title="Sell", style=shape.triangledown, location=location.abovebar, color=sellCol, size=size.small, text="SELL", textcolor=sellCol)


// ───────────────────────────── Alerts ──────────────────────────────────────
alertcondition(isNew4h and show4h,  "New 4H FVG",  "A new 4H Fair Value Gap has formed")
alertcondition(isNew15 and show15m, "New 15M FVG",  "A new 15M Fair Value Gap has formed")
alertcondition(buySignal,           "Buy Signal",  "4H+15M FVG confluence during formation - BUY")
alertcondition(sellSignal,          "Sell Signal", "4H+15M FVG confluence during formation - SELL")
