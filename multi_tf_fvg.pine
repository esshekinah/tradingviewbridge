//@version=5
indicator("Multi-TF FVG (4H + 15M)", overlay=true, max_boxes_count=500, max_lines_count=500)

// ============================================================================
// Multi-Timeframe Fair Value Gap (FVG) Indicator
// ----------------------------------------------------------------------------
// Detects Fair Value Gaps on the 4H and 15M timeframes and draws them on
// ANY chart timeframe you are currently viewing.
//
// An FVG (a.k.a. imbalance) is a 3-candle pattern:
//   Bullish FVG : low of candle[1]  >  high of candle[3]   (gap between them)
//   Bearish FVG : high of candle[1] <  low  of candle[3]   (gap between them)
// The gap is the untraded price range between candle 1 and candle 3.
// ============================================================================


// ─────────────────────────────── Inputs ────────────────────────────────────
grp1 = "4H FVG Settings"
show4h        = input.bool(true,  "Show 4H FVGs",                 group=grp1)
tf4h          = input.timeframe("240", "4H Timeframe",            group=grp1)
bull4hCol     = input.color(color.new(color.teal,   80), "4H Bullish",  group=grp1, inline="c4")
bear4hCol     = input.color(color.new(color.red,    80), "4H Bearish",  group=grp1, inline="c4")

grp2 = "15M FVG Settings"
show15m       = input.bool(true,  "Show 15M FVGs",                group=grp2)
tf15m         = input.timeframe("15", "15M Timeframe",            group=grp2)
bull15mCol    = input.color(color.new(color.aqua,   70), "15M Bullish", group=grp2, inline="c15")
bear15mCol    = input.color(color.new(color.orange, 70), "15M Bearish", group=grp2, inline="c15")
only15mIn4h   = input.bool(true,  "Only 15M FVGs inside a 4H FVG (confluence)", group=grp2, tooltip="When on, a 15M FVG is drawn only if any part of its range overlaps an active (unmitigated) 4H FVG zone.")

grp3 = "Signal Settings"
showSignals   = input.bool(true, "Show Buy/Sell signals", group=grp3)
signalThresh  = input.float(4.0, "Max line distance (price points)", minval=0.0, step=0.1, group=grp3, tooltip="When any 4H FVG level (Bottom / CE / Top) is within this many price points of any 15M FVG level, a Buy (bullish) or Sell (bearish) signal is plotted. Set to match the instrument's scale — e.g. ~4 on an index like US Tech 100.")
buyCol        = input.color(color.lime, "Buy signal",  group=grp3, inline="sig")
sellCol       = input.color(color.red,  "Sell signal", group=grp3, inline="sig")

grp4 = "General"
maxFvgs       = input.int(20,  "Max FVGs to keep per set", minval=1, maxval=100, group=grp4)
extendBars    = input.int(30,  "Extend boxes (bars)",      minval=0, maxval=500, group=grp4)
removeFilled  = input.bool(true, "Remove FVG when filled (mitigated)", group=grp4)
showLabels    = input.bool(true, "Show timeframe labels",   group=grp4)
borderWidth   = input.int(1,   "Border width", minval=0, maxval=4, group=grp4)


// ─────────────────────────── FVG data type ─────────────────────────────────
type FVG
    box   bx
    float top
    float bot
    bool  isBull
    bool  filled


// ─────────────── Request 3-candle data from a higher timeframe ──────────────
// We pull high/low of candle[1] and candle[3] plus the bar time of candle[2]
// (the middle candle, which anchors the gap on the timeline).
// Wrapped in a function so we can reuse it for each timeframe.
reqTF(simple string tf) =>
    request.security(syminfo.tickerid, tf,
         [high[1], low[1], high[3], low[3], time[2], ta.change(time[1]) != 0],
         lookahead=barmerge.lookahead_off)


// Returns true if the price range [bot, top] overlaps any active (unfilled)
// FVG in the given confluence set. Overlap = "fully inside" OR "partly inside".
overlapsAny(array<FVG> conf, float bot, float top) =>
    bool hit = false
    if conf.size() > 0
        for i = 0 to conf.size() - 1
            FVG z = conf.get(i)
            // Two ranges overlap when each starts before the other ends.
            if not z.filled and bot <= z.top and z.bot <= top
                hit := true
    hit


// CE (Consequent Encroachment) = midpoint of an FVG.
ce(float top, float bot) => (top + bot) / 2.0


// Compares the 3 levels (Bottom, CE, Top) of a 15M FVG against the 3 levels of
// every active 4H FVG. Returns true if ANY 4H level is within `thresh` price
// points of ANY 15M level (9 pairwise comparisons per 4H FVG).
levelsAligned(array<FVG> conf, float bot15, float ce15, float top15, float thresh) =>
    bool aligned = false
    if conf.size() > 0
        for i = 0 to conf.size() - 1
            FVG z = conf.get(i)
            if not z.filled
                float ce4 = ce(z.top, z.bot)
                // 3 x 3 = 9 line-to-line distance checks.
                bool near = math.abs(z.bot - bot15) <= thresh or math.abs(z.bot - ce15) <= thresh or math.abs(z.bot - top15) <= thresh or math.abs(ce4 - bot15) <= thresh or math.abs(ce4 - ce15) <= thresh or math.abs(ce4 - top15) <= thresh or math.abs(z.top - bot15) <= thresh or math.abs(z.top - ce15) <= thresh or math.abs(z.top - top15) <= thresh
                if near
                    aligned := true
    aligned


// ─────────────────────── FVG detection + drawing ───────────────────────────
// Detects a new FVG on the given HTF stream and appends a box to the array.
// If requireConf is true, the FVG is only drawn when its range overlaps an
// active FVG in the `conf` set (used to keep only 15M FVGs inside 4H FVGs).
detectFVG(array<FVG> store, float hh1, float ll1, float hh3, float ll3, int t2mid, bool isNew, color bullCol, color bearCol, string tfLabel, bool showLbl, array<FVG> conf, bool requireConf, bool visible) =>
    bool  drawn   = false
    float newTop  = na
    float newBot  = na
    bool  newBull = false
    if isNew and not na(hh1) and not na(hh3)
        bool bull = ll1 > hh3          // gap up: current low above old high
        bool bear = hh1 < ll3          // gap down: current high below old low
        if bull or bear
            float top = bull ? ll1 : ll3
            float bot = bull ? hh3 : hh1
            // Confluence filter: skip 15M FVGs not overlapping a 4H FVG.
            bool passConf = requireConf ? overlapsAny(conf, bot, top) : true
            if passConf
                drawn   := true
                newTop  := top
                newBot  := bot
                newBull := bull
                color col      = bull ? bullCol : bearCol
                // When not visible (4H used only as a hidden confluence filter),
                // draw the box fully transparent so it still exists for logic.
                color bgCol    = visible ? col : color.new(col, 100)
                color bordCol  = visible ? color.new(col, 0) : color.new(col, 100)
                box b = box.new(left = t2mid, top = top, right = t2mid + 1, bottom = bot, xloc = xloc.bar_time, border_color = bordCol, border_width = borderWidth, bgcolor = bgCol)
                if showLbl
                    box.set_text(b, tfLabel + (bull ? " Bull FVG" : " Bear FVG"))
                    box.set_text_size(b, size.tiny)
                    box.set_text_color(b, color.new(color.gray, 20))
                    box.set_text_halign(b, text.align_left)
                    box.set_text_valign(b, text.align_center)
                store.push(FVG.new(b, top, bot, bull, false))
                // Trim oldest
                if store.size() > maxFvgs
                    FVG old = store.shift()
                    box.delete(old.bx)
    [drawn, newBot, newTop, newBull]


// Keeps FVG boxes extending to the right, and removes mitigated ones.
maintainFVG(array<FVG> store) =>
    if store.size() > 0
        for i = store.size() - 1 to 0
            FVG f = store.get(i)
            if not f.filled
                // extend the box forward in time
                box.set_right(f.bx, time + extendBars * (timeframe.in_seconds() * 1000))
                // mitigation check: price traded fully through the gap
                bool mitigated = f.isBull ? (low <= f.bot) : (high >= f.top)
                if mitigated
                    f.filled := true
                    if removeFilled
                        box.delete(f.bx)
                        store.remove(i)


// ───────────────────────────── Storage ─────────────────────────────────────
var array<FVG> fvg4h  = array.new<FVG>()
var array<FVG> fvg15m = array.new<FVG>()


// ─────────────────────── Pull HTF streams ──────────────────────────────────
[H1_4h, L1_4h, H3_4h, L3_4h, T2_4h, isNew4h]     = reqTF(tf4h)
[H1_15, L1_15, H3_15, L3_15, T2_15, isNew15]     = reqTF(tf15m)


// ─────────────────────────── Run detection ─────────────────────────────────
// IMPORTANT: process 4H first so its zones exist when we filter 15M FVGs.
// We also maintain (mitigate/extend) 4H BEFORE the 15M confluence check so a
// 15M FVG is only kept when it overlaps a still-active 4H zone.
// Detect 4H FVGs whenever they're shown OR needed as a confluence filter for 15M.
if show4h or only15mIn4h
    detectFVG(fvg4h, H1_4h, L1_4h, H3_4h, L3_4h, T2_4h, isNew4h, bull4hCol, bear4hCol, "4H", showLabels and show4h, fvg4h, false, show4h)
maintainFVG(fvg4h)

bool  drew15m  = false
float new15Bot = na
float new15Top = na
bool  new15Bull = false
if show15m
    [d15, nb15, nt15, bull15] = detectFVG(fvg15m, H1_15, L1_15, H3_15, L3_15, T2_15, isNew15, bull15mCol, bear15mCol, "15M", showLabels, fvg4h, only15mIn4h, true)
    drew15m   := d15
    new15Bot  := nb15
    new15Top  := nt15
    new15Bull := bull15
maintainFVG(fvg15m)


// ─────────────────────── Buy / Sell signal logic ───────────────────────────
// When a new 15M FVG is created, compare its Bottom / CE / Top levels against
// the Bottom / CE / Top levels of every active 4H FVG. If any pair of lines is
// within `signalThresh` price points, fire a signal:
//   Buy  → bullish 15M FVG   |   Sell → bearish 15M FVG
bool buySignal  = false
bool sellSignal = false
if showSignals and drew15m and not na(new15Bot)
    float ce15 = ce(new15Top, new15Bot)
    bool aligned = levelsAligned(fvg4h, new15Bot, ce15, new15Top, signalThresh)
    if aligned
        buySignal  := new15Bull
        sellSignal := not new15Bull

plotshape(buySignal,  title="Buy",  style=shape.triangleup,   location=location.belowbar, color=buyCol,  size=size.small, text="BUY",  textcolor=buyCol)
plotshape(sellSignal, title="Sell", style=shape.triangledown, location=location.abovebar, color=sellCol, size=size.small, text="SELL", textcolor=sellCol)


// ───────────────────────────── Alerts ──────────────────────────────────────
alertcondition(isNew4h and show4h,  "New 4H FVG",  "A new 4H Fair Value Gap has formed")
alertcondition(drew15m,             "New 15M FVG in 4H", "A new 15M FVG formed inside a 4H FVG zone")
alertcondition(buySignal,           "Buy Signal",  "4H/15M FVG levels aligned - BUY")
alertcondition(sellSignal,          "Sell Signal", "4H/15M FVG levels aligned - SELL")
