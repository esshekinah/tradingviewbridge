//@version=5
indicator("Bottom Top Tick | Emmanuel", overlay=true, max_lines_count=500, max_labels_count=500)

// ============================================================================
// Multi-Timeframe FVG + Order Block Indicator
// ----------------------------------------------------------------------------
// Detects Fair Value Gaps (FVG) AND Order Blocks (OB) on the Weekly, Daily, 4H
// and 15M timeframes and draws them on ANY chart timeframe you are viewing.
//
// FVG (imbalance) — a 3-candle pattern:
//   Bullish FVG : low of candle[1]  >  high of candle[3]
//   Bearish FVG : high of candle[1] <  low  of candle[3]
//
// OB (order block) — the last opposite-direction candle before an engulfing
// break (2-candle rule), body only:
//   Bullish OB : prev candle bearish (close<open) AND current close > prev high
//   Bearish OB : prev candle bullish (close>open) AND current close < prev low
//   Zone = the prev candle's BODY: Top = max(open,close), Bottom = min(open,close)
//
// Both FVGs and OBs are drawn as THREE horizontal lines — Top, CE (midpoint),
// Bottom — each labelled at its right end, e.g.:
//   +W FVG Top / CE / Bottom      ( + = bullish )
//   -D OB  Top / CE / Bottom      ( - = bearish )
//
// Each line extends to the right until its own level is mitigated (price
// re-enters from the open side), then it is frozen at the mitigation bar.
// ============================================================================


// ─────────────────────────────── Inputs ────────────────────────────────────
grpW = "Weekly Settings"
showW         = input.bool(true,   "Show Weekly FVGs",   group=grpW)
showWOB       = input.bool(true,   "Show Weekly OBs",    group=grpW)
tfW           = input.timeframe("W",   "Weekly Timeframe", group=grpW)

grpD = "Daily Settings"
showD         = input.bool(true,   "Show Daily FVGs",    group=grpD)
showDOB       = input.bool(true,   "Show Daily OBs",     group=grpD)
tfD           = input.timeframe("D",   "Daily Timeframe",  group=grpD)

grp1 = "4H Settings"
show4h        = input.bool(true,   "Show 4H FVGs",       group=grp1)
show4hOB      = input.bool(true,   "Show 4H OBs",        group=grp1)
tf4h          = input.timeframe("240", "4H Timeframe",   group=grp1)

grp2 = "15M Settings"
show15m       = input.bool(true,   "Show 15M FVGs",      group=grp2)
show15mOB     = input.bool(true,   "Show 15M OBs",       group=grp2)
tf15m         = input.timeframe("15",  "15M Timeframe",  group=grp2)

// Colors are per-timeframe and shared by both FVG and OB: one line color and
// one text color for each direction (bullish / bearish).
grpCW = "Weekly Colors"
bullWCol      = input.color(color.new(color.yellow, 95),  "Bullish (+) line",  group=grpCW, inline="l")
bearWCol      = input.color(color.new(color.fuchsia,95),  "Bearish (-) line",  group=grpCW, inline="l")
txtBullWCol   = input.color(color.white,                  "Bullish (+) text",  group=grpCW, inline="t")
txtBearWCol   = input.color(color.white,                  "Bearish (-) text",  group=grpCW, inline="t")

grpCD = "Daily Colors"
bullDCol      = input.color(color.new(color.lime,  95),   "Bullish (+) line",  group=grpCD, inline="l")
bearDCol      = input.color(color.new(color.maroon,95),   "Bearish (-) line",  group=grpCD, inline="l")
txtBullDCol   = input.color(color.white,                  "Bullish (+) text",  group=grpCD, inline="t")
txtBearDCol   = input.color(color.white,                  "Bearish (-) text",  group=grpCD, inline="t")

grpC4 = "4H Colors"
bull4hCol     = input.color(color.new(color.white, 95),   "Bullish (+) line",  group=grpC4, inline="l")
bear4hCol     = input.color(color.new(color.red,   95),   "Bearish (-) line",  group=grpC4, inline="l")
txtBull4hCol  = input.color(color.white,                  "Bullish (+) text",  group=grpC4, inline="t")
txtBear4hCol  = input.color(color.white,                  "Bearish (-) text",  group=grpC4, inline="t")

grpC15 = "15M Colors"
bull15mCol    = input.color(color.new(color.aqua,  95),   "Bullish (+) line",  group=grpC15, inline="l")
bear15mCol    = input.color(color.new(color.orange,95),   "Bearish (-) line",  group=grpC15, inline="l")
txtBull15mCol = input.color(color.white,                  "Bullish (+) text",  group=grpC15, inline="t")
txtBear15mCol = input.color(color.white,                  "Bearish (-) text",  group=grpC15, inline="t")

grpLW = "Line Style"
lineWidth     = input.int(1, "Line width", minval=1, maxval=4, group=grpLW)
mitModeInp    = input.string("Wick", "Mitigation by", options=["Wick","Body"], group=grpLW, tooltip="A level freezes only when price RE-ENTERS the zone from the correct side. Wick = the candle wick reaching the level (high/low); Body = the candle body reaching it (open/close).")

// Per-category line visibility: {W,D,4H,15M} x {Bull,Bear} x {Top,CE,Bottom}.
grpWB = "Show/Hide Lines — Weekly Bullish (+)"
sWBullTop = input.bool(true, "Top",    group=grpWB, inline="r")
sWBullCE  = input.bool(true, "CE",     group=grpWB, inline="r")
sWBullBot = input.bool(true, "Bottom", group=grpWB, inline="r")

grpWS = "Show/Hide Lines — Weekly Bearish (-)"
sWBearTop = input.bool(true, "Top",    group=grpWS, inline="r")
sWBearCE  = input.bool(true, "CE",     group=grpWS, inline="r")
sWBearBot = input.bool(true, "Bottom", group=grpWS, inline="r")

grpDB = "Show/Hide Lines — Daily Bullish (+)"
sDBullTop = input.bool(true, "Top",    group=grpDB, inline="r")
sDBullCE  = input.bool(true, "CE",     group=grpDB, inline="r")
sDBullBot = input.bool(true, "Bottom", group=grpDB, inline="r")

grpDS = "Show/Hide Lines — Daily Bearish (-)"
sDBearTop = input.bool(true, "Top",    group=grpDS, inline="r")
sDBearCE  = input.bool(true, "CE",     group=grpDS, inline="r")
sDBearBot = input.bool(true, "Bottom", group=grpDS, inline="r")

grp8 = "Show/Hide Lines — 4H Bullish (+)"
s4hBullTop = input.bool(true, "Top",    group=grp8, inline="r")
s4hBullCE  = input.bool(true, "CE",     group=grp8, inline="r")
s4hBullBot = input.bool(true, "Bottom", group=grp8, inline="r")

grp9 = "Show/Hide Lines — 4H Bearish (-)"
s4hBearTop = input.bool(true, "Top",    group=grp9, inline="r")
s4hBearCE  = input.bool(true, "CE",     group=grp9, inline="r")
s4hBearBot = input.bool(true, "Bottom", group=grp9, inline="r")

grp10 = "Show/Hide Lines — 15M Bullish (+)"
s15BullTop = input.bool(true, "Top",    group=grp10, inline="r")
s15BullCE  = input.bool(true, "CE",     group=grp10, inline="r")
s15BullBot = input.bool(true, "Bottom", group=grp10, inline="r")

grp11 = "Show/Hide Lines — 15M Bearish (-)"
s15BearTop = input.bool(true, "Top",    group=grp11, inline="r")
s15BearCE  = input.bool(true, "CE",     group=grp11, inline="r")
s15BearBot = input.bool(true, "Bottom", group=grp11, inline="r")

// Per-category OB line visibility: {W,D,4H,15M} x {Bull,Bear} x {Top,CE,Bottom}.
grpOWB = "Show/Hide OB Lines — Weekly Bullish (+)"
oWBullTop = input.bool(true, "Top",    group=grpOWB, inline="r")
oWBullCE  = input.bool(true, "CE",     group=grpOWB, inline="r")
oWBullBot = input.bool(true, "Bottom", group=grpOWB, inline="r")

grpOWS = "Show/Hide OB Lines — Weekly Bearish (-)"
oWBearTop = input.bool(true, "Top",    group=grpOWS, inline="r")
oWBearCE  = input.bool(true, "CE",     group=grpOWS, inline="r")
oWBearBot = input.bool(true, "Bottom", group=grpOWS, inline="r")

grpODB = "Show/Hide OB Lines — Daily Bullish (+)"
oDBullTop = input.bool(true, "Top",    group=grpODB, inline="r")
oDBullCE  = input.bool(true, "CE",     group=grpODB, inline="r")
oDBullBot = input.bool(true, "Bottom", group=grpODB, inline="r")

grpODS = "Show/Hide OB Lines — Daily Bearish (-)"
oDBearTop = input.bool(true, "Top",    group=grpODS, inline="r")
oDBearCE  = input.bool(true, "CE",     group=grpODS, inline="r")
oDBearBot = input.bool(true, "Bottom", group=grpODS, inline="r")

grpO4B = "Show/Hide OB Lines — 4H Bullish (+)"
o4hBullTop = input.bool(true, "Top",    group=grpO4B, inline="r")
o4hBullCE  = input.bool(true, "CE",     group=grpO4B, inline="r")
o4hBullBot = input.bool(true, "Bottom", group=grpO4B, inline="r")

grpO4S = "Show/Hide OB Lines — 4H Bearish (-)"
o4hBearTop = input.bool(true, "Top",    group=grpO4S, inline="r")
o4hBearCE  = input.bool(true, "CE",     group=grpO4S, inline="r")
o4hBearBot = input.bool(true, "Bottom", group=grpO4S, inline="r")

grpO15B = "Show/Hide OB Lines — 15M Bullish (+)"
o15BullTop = input.bool(true, "Top",    group=grpO15B, inline="r")
o15BullCE  = input.bool(true, "CE",     group=grpO15B, inline="r")
o15BullBot = input.bool(true, "Bottom", group=grpO15B, inline="r")

grpO15S = "Show/Hide OB Lines — 15M Bearish (-)"
o15BearTop = input.bool(true, "Top",    group=grpO15S, inline="r")
o15BearCE  = input.bool(true, "CE",     group=grpO15S, inline="r")
o15BearBot = input.bool(true, "Bottom", group=grpO15S, inline="r")

grp4 = "General"
maxFvgs       = input.int(20,  "Max FVGs to keep per set", minval=1, maxval=100, group=grp4)
extendBars    = input.int(30,  "Extend lines (bars)",      minval=0, maxval=500, group=grp4)
showLabels    = input.bool(true, "Show text labels",   group=grp4)
showMitLabels = input.bool(true, "Show mitigated line labels", group=grp4, tooltip="When off, a level's text label is removed once that level is mitigated (the line still stays, frozen at the mitigation bar). Active levels always keep their label.")
lblSizeInp    = input.string("Small", "Label text size", options=["Tiny","Small","Normal","Large"], group=grp4)
lblFontInp    = input.string("Default", "Label font", options=["Default","Monospace"], group=grp4, tooltip="Pine Script only supports these two font families — a true Arial cannot be selected. 'Default' is TradingView's standard sans-serif (Arial-like).")

grp7 = "Dashboard (color legend)"
showDash      = input.bool(false, "Show dashboard", group=grp7)
dashPosInp    = input.string("Top Right", "Position", options=["Top Right","Top Left","Bottom Right","Bottom Left","Middle Right"], group=grp7)
dashSizeInp   = input.string("Small", "Dashboard text size", options=["Tiny","Small","Normal","Large"], group=grp7)
dashBgCol     = input.color(color.new(color.black, 20), "Background", group=grp7, inline="dbg")
dashTxtCol    = input.color(color.white, "Text", group=grp7, inline="dbg")


// ─────────────────────────── FVG data type ─────────────────────────────────
// Each FVG owns 3 lines and their 3 labels. A line is `na` when its level is
// hidden by the user. `topDone/ceDone/botDone` mark a level as mitigated so it
// stops extending (the line is left frozen at the mitigation bar).
type FVG
    float top
    float ce
    float bot
    bool  isBull
    int   dispStart   // displacement candle open time (ms)
    int   dispEnd     // displacement candle close time (ms) = start + TF duration
    line  topLn
    line  ceLn
    line  botLn
    label topLbl
    label ceLbl
    label botLbl
    bool  topDone
    bool  ceDone
    bool  botDone


// ─────────────── Request 3-candle data from a higher timeframe ──────────────
// We pull high/low of candle[1] and candle[3] plus the bar time of candle[2]
// (the middle candle, which anchors the gap on the timeline).
reqTF(simple string tf) =>
    request.security(syminfo.tickerid, tf,
         [high[1], low[1], high[3], low[3], time[2], ta.change(time[1]) != 0],
         lookahead=barmerge.lookahead_off)


// ─────────────── Request OB data from a higher timeframe ────────────────────
// The OB candidate is the PREVIOUS candle; the breakout is the CURRENT candle.
// We pull the prev candle's OHLC + time, and the current candle's close, plus a
// new-bar flag. (Bullish OB: prev bearish AND current close > prev high, etc.)
reqTFob(simple string tf) =>
    request.security(syminfo.tickerid, tf,
         [open[1], close[1], high[1], low[1], time[1], close, ta.change(time[1]) != 0],
         lookahead=barmerge.lookahead_off)


// CE (Consequent Encroachment) = midpoint of an FVG.
ceOf(float top, float bot) => (top + bot) / 2.0

// Does the price range [bot, top] overlap ANY active (unmitigated),
// SAME-DIRECTION zone in `pool`? Overlap = partial or full price intersection.
// Used to gate 15M FVGs/OBs so they only draw inside an HTF FVG or OB.
// A zone counts as active while at least one of its levels is un-mitigated.
overlapsHTF(array<FVG> pool, float bot, float top, bool isBull) =>
    bool hit = false
    if pool.size() > 0
        for i = 0 to pool.size() - 1
            FVG z = pool.get(i)
            bool active = not (z.topDone and z.ceDone and z.botDone)
            if active and z.isBull == isBull and bot <= z.top and z.bot <= top
                hit := true
    hit

// Has price reached `lvl` from BELOW (rallying up into it)? Used to mitigate
// bearish-FVG levels, which sit above and are filled when price rallies back up.
//   Wick mode → the bar's high reaches lvl.
//   Body mode → the bar's body top (max of open/close) reaches lvl.
reachedFromBelow(float lvl) =>
    (mitModeInp == "Body" ? math.max(open, close) : high) >= lvl

// Has price reached `lvl` from ABOVE (dropping down into it)? Used to mitigate
// bullish-FVG levels, which sit below and are filled when price drops back down.
//   Wick mode → the bar's low reaches lvl.
//   Body mode → the bar's body bottom (min of open/close) reaches lvl.
reachedFromAbove(float lvl) =>
    (mitModeInp == "Body" ? math.min(open, close) : low) <= lvl

// Map label-size input string to a Pine size constant.
lblSize() =>
    lblSizeInp == "Tiny" ? size.tiny : lblSizeInp == "Normal" ? size.normal : lblSizeInp == "Large" ? size.large : size.small

// Map label-font input string to a Pine font-family constant.
// Pine only exposes these two families — no custom/Arial font is available.
lblFont() =>
    lblFontInp == "Monospace" ? font.family_monospace : font.family_default

// Map dashboard position / size input strings to Pine constants.
dashPos() =>
    dashPosInp == "Top Left" ? position.top_left : dashPosInp == "Bottom Right" ? position.bottom_right : dashPosInp == "Bottom Left" ? position.bottom_left : dashPosInp == "Middle Right" ? position.middle_right : position.top_right
dashSize() =>
    dashSizeInp == "Tiny" ? size.tiny : dashSizeInp == "Normal" ? size.normal : dashSizeInp == "Large" ? size.large : size.small


// Create one horizontal level line + right-end label. Returns [line, label].
// `col` = line color, `txtCol` = label text color (configured independently).
mkLevel(int t2mid, float lvl, color col, color txtCol, string txt, bool show, bool showLbl, int tfMs) =>
    line  ln = na
    label lb = na
    if show
        // Right edge starts one full HTF bar past the start so the line has a
        // visible width even before maintainFVG extends it (a +1ms width can
        // render as an invisible zero-length line on lower chart timeframes).
        int x2 = t2mid + tfMs
        ln := line.new(x1 = t2mid, y1 = lvl, x2 = x2, y2 = lvl, xloc = xloc.bar_time, color = col, style = line.style_solid, width = lineWidth)
        if showLbl
            lb := label.new(x = x2, y = lvl, xloc = xloc.bar_time, text = txt, textcolor = txtCol, color = color.new(color.black, 100), style = label.style_label_left, size = lblSize(), text_font_family = lblFont())
    [ln, lb]


// ─────────────────────── FVG detection + drawing ───────────────────────────
// Detects a new FVG on the given HTF stream and appends it to `store`, drawing
// the Top/CE/Bottom lines and labels. `tfMs` bounds the displacement window.
// Returns [confirmed, bot, top, isBull, dispStart, dispEnd] for the new FVG.
detectFVG(array<FVG> store, float hh1, float ll1, float hh3, float ll3, int t2mid, int tfMs, bool isNew, string tfLabel, bool visible, bool showLbl, color bullC, color bearC, color bullTxtC, color bearTxtC, bool bullTop, bool bullCE, bool bullBot, bool bearTop, bool bearCE, bool bearBot, bool requireConf, array<FVG> htf) =>
    bool  drawn   = false
    float newTop  = na
    float newBot  = na
    bool  newBull = false
    int   newDS   = na
    int   newDE   = na
    if isNew and not na(hh1) and not na(hh3)
        bool bull = ll1 > hh3          // gap up: current low above old high
        bool bear = hh1 < ll3          // gap down: current high below old low
        if bull or bear
            float top = bull ? ll1 : ll3
            float bot = bull ? hh3 : hh1
            float ceL = ceOf(top, bot)
            // Confluence gate: 15M zones only draw if they overlap an active,
            // same-direction HTF zone (any W/D/4H FVG or OB) in `htf`.
            bool passConf = requireConf ? overlapsHTF(htf, bot, top, bull) : true
            if passConf
                int dStart = t2mid
                int dEnd   = t2mid + tfMs
                drawn   := true
                newTop  := top
                newBot  := bot
                newBull := bull
                newDS   := dStart
                newDE   := dEnd

                color col  = bull ? bullC : bearC
                string sgn = bull ? "+" : "-"           // + bullish, - bearish
                string pfx = sgn + tfLabel + " FVG "    // e.g. "+4H FVG "

                // Pick this FVG's per-category visibility trio (bull vs bear).
                bool shTop = bull ? bullTop : bearTop
                bool shCE  = bull ? bullCE  : bearCE
                bool shBot = bull ? bullBot : bearBot
                color txtCol = bull ? bullTxtC : bearTxtC

                [tLn, tLb] = mkLevel(t2mid, top, col, txtCol, pfx + "Top",    visible and shTop, showLbl, tfMs)
                [cLn, cLb] = mkLevel(t2mid, ceL, col, txtCol, pfx + "CE",     visible and shCE,  showLbl, tfMs)
                [bLn, bLb] = mkLevel(t2mid, bot, col, txtCol, pfx + "Bottom", visible and shBot, showLbl, tfMs)

                store.push(FVG.new(top, ceL, bot, bull, dStart, dEnd, tLn, cLn, bLn, tLb, cLb, bLb, false, false, false))

                // Trim oldest (delete its drawings).
                if store.size() > maxFvgs
                    FVG old = store.shift()
                    line.delete(old.topLn)
                    line.delete(old.ceLn)
                    line.delete(old.botLn)
                    label.delete(old.topLbl)
                    label.delete(old.ceLbl)
                    label.delete(old.botLbl)
    [drawn, newBot, newTop, newBull, newDS, newDE]


// ─────────────────────── OB detection + drawing ────────────────────────────
// Order Block (2-candle rule, body only). `po/pc/ph/pl` = the previous (OB)
// candle's open/close/high/low; `pt` = its open time; `cc` = current (breakout)
// candle's close. Reuses the FVG type/store + mkLevel + maintainFVG.
//   Bullish OB : prev bearish (pc < po) AND cc > ph  → zone = prev body
//   Bearish OB : prev bullish (pc > po) AND cc < pl  → zone = prev body
detectOB(array<FVG> store, float po, float pc, float ph, float pl, int pt, float cc, int tfMs, bool isNew, string tfLabel, bool visible, bool showLbl, color bullC, color bearC, color bullTxtC, color bearTxtC, bool bullTop, bool bullCE, bool bullBot, bool bearTop, bool bearCE, bool bearBot, bool requireConf, array<FVG> htf) =>
    if isNew and not na(po) and not na(pc) and not na(cc)
        bool bull = (pc < po) and (cc > ph)   // prev bearish, current closes above prev high
        bool bear = (pc > po) and (cc < pl)   // prev bullish, current closes below prev low
        if bull or bear
            // Body-only zone of the OB (prev) candle.
            float top = math.max(po, pc)
            float bot = math.min(po, pc)
            float ceL = ceOf(top, bot)
            // Confluence gate: 15M OBs only draw if they overlap an active,
            // same-direction HTF zone (any W/D/4H FVG or OB) in `htf`.
            bool passConf = requireConf ? overlapsHTF(htf, bot, top, bull) : true
            if passConf
                int dStart = pt
                int dEnd   = pt + tfMs

                color col  = bull ? bullC : bearC
                string sgn = bull ? "+" : "-"
                string pfx = sgn + tfLabel + " OB "    // e.g. "+4H OB "

                bool shTop = bull ? bullTop : bearTop
                bool shCE  = bull ? bullCE  : bearCE
                bool shBot = bull ? bullBot : bearBot
                color txtCol = bull ? bullTxtC : bearTxtC

                [tLn, tLb] = mkLevel(pt, top, col, txtCol, pfx + "Top",    visible and shTop, showLbl, tfMs)
                [cLn, cLb] = mkLevel(pt, ceL, col, txtCol, pfx + "CE",     visible and shCE,  showLbl, tfMs)
                [bLn, bLb] = mkLevel(pt, bot, col, txtCol, pfx + "Bottom", visible and shBot, showLbl, tfMs)

                store.push(FVG.new(top, ceL, bot, bull, dStart, dEnd, tLn, cLn, bLn, tLb, cLb, bLb, false, false, false))

                if store.size() > maxFvgs
                    FVG old = store.shift()
                    line.delete(old.topLn)
                    line.delete(old.ceLn)
                    line.delete(old.botLn)
                    label.delete(old.topLbl)
                    label.delete(old.ceLbl)
                    label.delete(old.botLbl)
    true


// Extends each still-active level to the right, and DISCONTINUES a level (stops
// extending, leaves it frozen) once price touches that specific level.
maintainFVG(array<FVG> store) =>
    if store.size() > 0
        int newRight = time + extendBars * (timeframe.in_seconds() * 1000)
        for i = 0 to store.size() - 1
            FVG f = store.get(i)

            // A level is mitigated only when price RE-ENTERS the gap from the
            // side it was left open:
            //   Bullish FVG (gap below price) → filled from ABOVE  (price drops in)
            //   Bearish FVG (gap above price) → filled from BELOW  (price rallies in)
            // On mitigation, freeze the line's right edge at THIS bar's time so
            // it ends exactly where price re-entered it.

            // Minimum right edge so a line/label is NEVER at or behind its own
            // start (x1 = dispStart). f.dispEnd = dispStart + one HTF bar (ms),
            // guaranteeing x2 > x1 by at least one HTF bar. Without this, on a
            // low chart TF the frozen/initial x2 can land <= x1, producing a
            // zero-length or backwards line that TradingView renders invisible.
            int frozenX  = math.max(time, f.dispEnd)
            int activeX  = math.max(newRight, f.dispEnd)

            // Mitigation may only START after the zone's CONFIRMATION candle has
            // closed — never on the candles that form it:
            //   FVG : confirmed when candle 3 closes.
            //   OB  : confirmed when the engulfing candle closes.
            // In both cases the confirming candle closes one HTF bar after
            // dispEnd, i.e. at dispEnd + (dispEnd - dispStart) = 2*dispEnd -
            // dispStart. Before that, lines just extend (never mitigate) so the
            // forming/engulfing candle can't falsely mitigate the zone.
            int  mitFrom   = 2 * f.dispEnd - f.dispStart
            bool mitActive = time >= mitFrom

            // Top level.
            if not f.topDone
                bool hitTop = mitActive and (f.isBull ? reachedFromAbove(f.top) : reachedFromBelow(f.top))
                if hitTop
                    f.topDone := true
                    if not na(f.topLn)
                        line.set_x2(f.topLn, frozenX)
                        if not na(f.topLbl)
                            if showMitLabels
                                label.set_x(f.topLbl, frozenX)
                            else
                                label.delete(f.topLbl)
                                f.topLbl := na
                else if not na(f.topLn)
                    line.set_x2(f.topLn, activeX)
                    // Label floats at the latest real bar so it stays visible.
                    if not na(f.topLbl)
                        label.set_x(f.topLbl, activeX)

            // Bottom level.
            if not f.botDone
                bool hitBot = mitActive and (f.isBull ? reachedFromAbove(f.bot) : reachedFromBelow(f.bot))
                if hitBot
                    f.botDone := true
                    if not na(f.botLn)
                        line.set_x2(f.botLn, frozenX)
                        if not na(f.botLbl)
                            if showMitLabels
                                label.set_x(f.botLbl, frozenX)
                            else
                                label.delete(f.botLbl)
                                f.botLbl := na
                else if not na(f.botLn)
                    line.set_x2(f.botLn, activeX)
                    if not na(f.botLbl)
                        label.set_x(f.botLbl, activeX)

            // CE (midpoint) level.
            if not f.ceDone
                bool hitCE = mitActive and (f.isBull ? reachedFromAbove(f.ce) : reachedFromBelow(f.ce))
                if hitCE
                    f.ceDone := true
                    if not na(f.ceLn)
                        line.set_x2(f.ceLn, frozenX)
                        if not na(f.ceLbl)
                            if showMitLabels
                                label.set_x(f.ceLbl, frozenX)
                            else
                                label.delete(f.ceLbl)
                                f.ceLbl := na
                else if not na(f.ceLn)
                    line.set_x2(f.ceLn, activeX)
                    if not na(f.ceLbl)
                        label.set_x(f.ceLbl, activeX)
    true


// ───────────────────────────── Storage ─────────────────────────────────────
var array<FVG> fvgW   = array.new<FVG>()
var array<FVG> fvgD   = array.new<FVG>()
var array<FVG> fvg4h  = array.new<FVG>()
var array<FVG> fvg15m = array.new<FVG>()
var array<FVG> obW    = array.new<FVG>()
var array<FVG> obD    = array.new<FVG>()
var array<FVG> ob4h   = array.new<FVG>()
var array<FVG> ob15m  = array.new<FVG>()


// ─────────────────────── Pull HTF streams ──────────────────────────────────
[H1_W,  L1_W,  H3_W,  L3_W,  T2_W,  isNewW]  = reqTF(tfW)
[H1_D,  L1_D,  H3_D,  L3_D,  T2_D,  isNewD]  = reqTF(tfD)
[H1_4h, L1_4h, H3_4h, L3_4h, T2_4h, isNew4h] = reqTF(tf4h)
[H1_15, L1_15, H3_15, L3_15, T2_15, isNew15] = reqTF(tf15m)

// OB streams (prev candle OHLC + time, current close, new-bar flag).
[oPO_W,  oPC_W,  oPH_W,  oPL_W,  oPT_W,  oCC_W,  obNewW]  = reqTFob(tfW)
[oPO_D,  oPC_D,  oPH_D,  oPL_D,  oPT_D,  oCC_D,  obNewD]  = reqTFob(tfD)
[oPO_4h, oPC_4h, oPH_4h, oPL_4h, oPT_4h, oCC_4h, obNew4h] = reqTFob(tf4h)
[oPO_15, oPC_15, oPH_15, oPL_15, oPT_15, oCC_15, obNew15] = reqTFob(tf15m)

int msW  = timeframe.in_seconds(tfW)   * 1000
int msD  = timeframe.in_seconds(tfD)   * 1000
int ms4h = timeframe.in_seconds(tf4h)  * 1000
int ms15 = timeframe.in_seconds(tf15m) * 1000


// ─────────────────────────── Run detection ─────────────────────────────────
// IMPORTANT ORDER: detect ALL higher-timeframe (W/D/4H) FVGs and OBs FIRST, so
// the 15M confluence filter can check overlap against the HTF zones that exist
// at the moment a 15M zone forms. `noConf` = empty pool for the HTF calls
// (they are never gated).
var array<FVG> noConf = array.new<FVG>()

// ── Higher-timeframe FVGs ──
if showW
    detectFVG(fvgW, H1_W, L1_W, H3_W, L3_W, T2_W, msW, isNewW, "W", showW, showLabels and showW, bullWCol, bearWCol, txtBullWCol, txtBearWCol, sWBullTop, sWBullCE, sWBullBot, sWBearTop, sWBearCE, sWBearBot, false, noConf)
maintainFVG(fvgW)

if showD
    detectFVG(fvgD, H1_D, L1_D, H3_D, L3_D, T2_D, msD, isNewD, "D", showD, showLabels and showD, bullDCol, bearDCol, txtBullDCol, txtBearDCol, sDBullTop, sDBullCE, sDBullBot, sDBearTop, sDBearCE, sDBearBot, false, noConf)
maintainFVG(fvgD)

if show4h
    detectFVG(fvg4h, H1_4h, L1_4h, H3_4h, L3_4h, T2_4h, ms4h, isNew4h, "4H", show4h, showLabels and show4h, bull4hCol, bear4hCol, txtBull4hCol, txtBear4hCol, s4hBullTop, s4hBullCE, s4hBullBot, s4hBearTop, s4hBearCE, s4hBearBot, false, noConf)
maintainFVG(fvg4h)

// ── Higher-timeframe OBs ──
if showWOB
    detectOB(obW, oPO_W, oPC_W, oPH_W, oPL_W, oPT_W, oCC_W, msW, obNewW, "W", showWOB, showLabels and showWOB, bullWCol, bearWCol, txtBullWCol, txtBearWCol, oWBullTop, oWBullCE, oWBullBot, oWBearTop, oWBearCE, oWBearBot, false, noConf)
maintainFVG(obW)

if showDOB
    detectOB(obD, oPO_D, oPC_D, oPH_D, oPL_D, oPT_D, oCC_D, msD, obNewD, "D", showDOB, showLabels and showDOB, bullDCol, bearDCol, txtBullDCol, txtBearDCol, oDBullTop, oDBullCE, oDBullBot, oDBearTop, oDBearCE, oDBearBot, false, noConf)
maintainFVG(obD)

if show4hOB
    detectOB(ob4h, oPO_4h, oPC_4h, oPH_4h, oPL_4h, oPT_4h, oCC_4h, ms4h, obNew4h, "4H", show4hOB, showLabels and show4hOB, bull4hCol, bear4hCol, txtBull4hCol, txtBear4hCol, o4hBullTop, o4hBullCE, o4hBullBot, o4hBearTop, o4hBearCE, o4hBearBot, false, noConf)
maintainFVG(ob4h)

// ── Combined active HTF pool (all W/D/4H FVGs + OBs) for the 15M filter ──
htfPool = array.new<FVG>()
htfPool.concat(fvgW)
htfPool.concat(fvgD)
htfPool.concat(fvg4h)
htfPool.concat(obW)
htfPool.concat(obD)
htfPool.concat(ob4h)

// ── 15M FVG + OB, gated: only drawn if they overlap a same-direction HTF zone ──
if show15m
    detectFVG(fvg15m, H1_15, L1_15, H3_15, L3_15, T2_15, ms15, isNew15, "15M", true, showLabels, bull15mCol, bear15mCol, txtBull15mCol, txtBear15mCol, s15BullTop, s15BullCE, s15BullBot, s15BearTop, s15BearCE, s15BearBot, true, htfPool)
maintainFVG(fvg15m)

if show15mOB
    detectOB(ob15m, oPO_15, oPC_15, oPH_15, oPL_15, oPT_15, oCC_15, ms15, obNew15, "15M", true, showLabels, bull15mCol, bear15mCol, txtBull15mCol, txtBear15mCol, o15BullTop, o15BullCE, o15BullBot, o15BearTop, o15BearCE, o15BearBot, true, htfPool)
maintainFVG(ob15m)


// ─────────────────────────── Dashboard (legend) ────────────────────────────
// Horizontal legend: one COLUMN per enabled level, with two rows —
//   row 0 = short label (e.g. "+4H FVG T" / "+4H FVG CE" / "-D OB B")
//   row 1 = the level's color swatch
// A level appears only if its timeframe is shown AND that level's toggle is on
// (so anything hidden on the chart is also omitted from the dashboard).
// Built once on the last bar for efficiency; rebuilt if inputs change.
var table dash = na

// Collect the enabled levels into parallel arrays (label + color), in order.
addLvl(array<string> labels, array<color> cols, bool shownTF, bool shownLvl, string txt, color c) =>
    if shownTF and shownLvl
        labels.push(txt)
        cols.push(c)
    true

if showDash and barstate.islast
    if not na(dash)
        table.delete(dash)

    array<string> dLbl = array.new<string>()
    array<color>  dCol = array.new<color>()

    // FVG levels (T / CE / B) for each timeframe & direction.
    addLvl(dLbl, dCol, showW,  sWBullTop, "+W FVG T",  bullWCol)
    addLvl(dLbl, dCol, showW,  sWBullCE,  "+W FVG CE", bullWCol)
    addLvl(dLbl, dCol, showW,  sWBullBot, "+W FVG B",  bullWCol)
    addLvl(dLbl, dCol, showW,  sWBearTop, "-W FVG T",  bearWCol)
    addLvl(dLbl, dCol, showW,  sWBearCE,  "-W FVG CE", bearWCol)
    addLvl(dLbl, dCol, showW,  sWBearBot, "-W FVG B",  bearWCol)
    addLvl(dLbl, dCol, showD,  sDBullTop, "+D FVG T",  bullDCol)
    addLvl(dLbl, dCol, showD,  sDBullCE,  "+D FVG CE", bullDCol)
    addLvl(dLbl, dCol, showD,  sDBullBot, "+D FVG B",  bullDCol)
    addLvl(dLbl, dCol, showD,  sDBearTop, "-D FVG T",  bearDCol)
    addLvl(dLbl, dCol, showD,  sDBearCE,  "-D FVG CE", bearDCol)
    addLvl(dLbl, dCol, showD,  sDBearBot, "-D FVG B",  bearDCol)
    addLvl(dLbl, dCol, show4h, s4hBullTop, "+4H FVG T",  bull4hCol)
    addLvl(dLbl, dCol, show4h, s4hBullCE,  "+4H FVG CE", bull4hCol)
    addLvl(dLbl, dCol, show4h, s4hBullBot, "+4H FVG B",  bull4hCol)
    addLvl(dLbl, dCol, show4h, s4hBearTop, "-4H FVG T",  bear4hCol)
    addLvl(dLbl, dCol, show4h, s4hBearCE,  "-4H FVG CE", bear4hCol)
    addLvl(dLbl, dCol, show4h, s4hBearBot, "-4H FVG B",  bear4hCol)
    addLvl(dLbl, dCol, show15m, s15BullTop, "+15M FVG T",  bull15mCol)
    addLvl(dLbl, dCol, show15m, s15BullCE,  "+15M FVG CE", bull15mCol)
    addLvl(dLbl, dCol, show15m, s15BullBot, "+15M FVG B",  bull15mCol)
    addLvl(dLbl, dCol, show15m, s15BearTop, "-15M FVG T",  bear15mCol)
    addLvl(dLbl, dCol, show15m, s15BearCE,  "-15M FVG CE", bear15mCol)
    addLvl(dLbl, dCol, show15m, s15BearBot, "-15M FVG B",  bear15mCol)

    // OB levels.
    addLvl(dLbl, dCol, showWOB,  oWBullTop, "+W OB T",  bullWCol)
    addLvl(dLbl, dCol, showWOB,  oWBullCE,  "+W OB CE", bullWCol)
    addLvl(dLbl, dCol, showWOB,  oWBullBot, "+W OB B",  bullWCol)
    addLvl(dLbl, dCol, showWOB,  oWBearTop, "-W OB T",  bearWCol)
    addLvl(dLbl, dCol, showWOB,  oWBearCE,  "-W OB CE", bearWCol)
    addLvl(dLbl, dCol, showWOB,  oWBearBot, "-W OB B",  bearWCol)
    addLvl(dLbl, dCol, showDOB,  oDBullTop, "+D OB T",  bullDCol)
    addLvl(dLbl, dCol, showDOB,  oDBullCE,  "+D OB CE", bullDCol)
    addLvl(dLbl, dCol, showDOB,  oDBullBot, "+D OB B",  bullDCol)
    addLvl(dLbl, dCol, showDOB,  oDBearTop, "-D OB T",  bearDCol)
    addLvl(dLbl, dCol, showDOB,  oDBearCE,  "-D OB CE", bearDCol)
    addLvl(dLbl, dCol, showDOB,  oDBearBot, "-D OB B",  bearDCol)
    addLvl(dLbl, dCol, show4hOB, o4hBullTop, "+4H OB T",  bull4hCol)
    addLvl(dLbl, dCol, show4hOB, o4hBullCE,  "+4H OB CE", bull4hCol)
    addLvl(dLbl, dCol, show4hOB, o4hBullBot, "+4H OB B",  bull4hCol)
    addLvl(dLbl, dCol, show4hOB, o4hBearTop, "-4H OB T",  bear4hCol)
    addLvl(dLbl, dCol, show4hOB, o4hBearCE,  "-4H OB CE", bear4hCol)
    addLvl(dLbl, dCol, show4hOB, o4hBearBot, "-4H OB B",  bear4hCol)
    addLvl(dLbl, dCol, show15mOB, o15BullTop, "+15M OB T",  bull15mCol)
    addLvl(dLbl, dCol, show15mOB, o15BullCE,  "+15M OB CE", bull15mCol)
    addLvl(dLbl, dCol, show15mOB, o15BullBot, "+15M OB B",  bull15mCol)
    addLvl(dLbl, dCol, show15mOB, o15BearTop, "-15M OB T",  bear15mCol)
    addLvl(dLbl, dCol, show15mOB, o15BearCE,  "-15M OB CE", bear15mCol)
    addLvl(dLbl, dCol, show15mOB, o15BearBot, "-15M OB B",  bear15mCol)

    int n = dLbl.size()
    if n > 0
        // One column per enabled level; 2 rows (label on top, swatch below).
        dash := table.new(position = dashPos(), columns = n, rows = 2, bgcolor = dashBgCol, border_color = color.new(color.gray, 50), border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)
        for i = 0 to n - 1
            table.cell(dash, i, 0, dLbl.get(i), text_color = dashTxtCol, text_size = dashSize(), text_font_family = lblFont())
            table.cell(dash, i, 1, "  ", bgcolor = dCol.get(i))
    else
        dash := na


// ───────────────────────────── Alerts ──────────────────────────────────────
alertcondition(isNewW  and showW,   "New Weekly FVG", "A new Weekly Fair Value Gap has formed")
alertcondition(isNewD  and showD,   "New Daily FVG",  "A new Daily Fair Value Gap has formed")
alertcondition(isNew4h and show4h,  "New 4H FVG",  "A new 4H Fair Value Gap has formed")
alertcondition(isNew15 and show15m, "New 15M FVG", "A new 15M Fair Value Gap has formed")

// OB new-formation alerts (bullish: prev bearish + close above prev high;
// bearish: prev bullish + close below prev low).
obHitW  = obNewW  and ((oPC_W  < oPO_W  and oCC_W  > oPH_W)  or (oPC_W  > oPO_W  and oCC_W  < oPL_W))
obHitD  = obNewD  and ((oPC_D  < oPO_D  and oCC_D  > oPH_D)  or (oPC_D  > oPO_D  and oCC_D  < oPL_D))
obHit4h = obNew4h and ((oPC_4h < oPO_4h and oCC_4h > oPH_4h) or (oPC_4h > oPO_4h and oCC_4h < oPL_4h))
obHit15 = obNew15 and ((oPC_15 < oPO_15 and oCC_15 > oPH_15) or (oPC_15 > oPO_15 and oCC_15 < oPL_15))
alertcondition(obHitW  and showWOB,   "New Weekly OB", "A new Weekly Order Block has formed")
alertcondition(obHitD  and showDOB,   "New Daily OB",  "A new Daily Order Block has formed")
alertcondition(obHit4h and show4hOB,  "New 4H OB",  "A new 4H Order Block has formed")
alertcondition(obHit15 and show15mOB, "New 15M OB", "A new 15M Order Block has formed")
